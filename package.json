{
  "name": "@zflxw/kepler-dictionary",
  "version": "1.1.2",
  "description": "A Kepler plugin that looks up words across Duden, DWDS, and Wiktionary without leaving your keyboard.",
  "private": false,
  "type": "module",
  "kepler": {
    "apiVersion": 1,
    "manifest": "dist/manifest.json",
    "entry": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zFlxw/kepler-dictionary.git"
  },
  "homepage": "https://github.com/zFlxw/kepler-dictionary#readme",
  "bugs": {
    "url": "https://github.com/zFlxw/kepler-dictionary/issues"
  },
  "scripts": {
    "build": "kepler-plugin bundle src/index.ts --out dist",
    "install:local": "kepler-plugin bundle src/index.ts --out \"$HOME/Library/Application Support/Kepler/Plugins/flxws-kepler-dictionary.keplugin\"",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "kepler",
    "kepler-plugin",
    "dictionary",
    "duden",
    "dwds",
    "wiktionary"
  ],
  "author": "Flxw",
  "license": "MIT",
  "packageManager": "pnpm@10.21.0",
  "dependencies": {
    "@kepler-app/plugin-sdk": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}